generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alertSettings AlertSettings?
  alertLogs AlertLog[]



  domains Domain[]
}

model Domain {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  registrar  String?
  expiryDate DateTime?
  autoRenew  Boolean  @default(false)
  renewCost  Float?
  currency   String?
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([expiryDate])
  alertLogs AlertLog[]

}

model AlertSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  alert30Days   Boolean  @default(true)
  alert7Days    Boolean  @default(true)
  alert1Day     Boolean  @default(true)
  weeklySummary Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AlertLog {
  id        String   @id @default(cuid())
  userId    String
  domainId  String
  type      String   // "D30" | "D7" | "D1" | "WEEKLY"
  sentAt    DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId, type])
  @@index([sentAt])
}
